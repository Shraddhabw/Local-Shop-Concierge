{
	email {$ACME_EMAIL}
	# Certificates for shop subdomains are issued on demand, but ONLY if the app says the slug exists.
	on_demand_tls {
		ask http://app:8000/internal/tls-ask
	}
}

(common) {
	encode zstd gzip
	# Only headers whose value is identical to the app's own (see SECURITY_HEADERS in app/main.py).
	# `defer` makes Caddy's value replace the app's, so each appears once. X-Frame-Options and the CSP
	# are NOT set here: the app sets them, and the chat embed page must be allowed to differ.
	# (The `?` default modifier is rejected by Caddy 2.11 in the proxy block's header_down: crash loop.)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		defer
	}
	request_body {
		max_size 256KB
	}
	# Never expose the internal endpoints (tls-ask) to the internet.
	@internal path /internal /internal/*
	respond @internal 404

	reverse_proxy app:8000 {
		# Replace anything the client sent: the app trusts only this value, from this container.
		header_up X-Forwarded-For {remote_host}
		header_down -Server
	}
}

# Apex and www: ordinary certificates, owner dashboard lives here
{$BASE_DOMAIN}, www.{$BASE_DOMAIN} {
	import common
}

# Every other host (shop subdomains): on-demand TLS, public page and chat only (the app enforces it)
https:// {
	tls {
		on_demand
	}
	import common
}
