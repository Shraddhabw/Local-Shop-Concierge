SECRET_KEY=change-me-long-random
BASE_DOMAIN=example.com
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=hello@example.com
SMTP_PASSWORD=
MAIL_FROM=hello@example.com
CONTACT_RECIPIENT=hello@example.com
AI_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
AI_DAILY_CAP=200
DATABASE_PATH=data/shop_concierge.db
# Comma-separated networks allowed to set X-Forwarded-For (the Caddy container's Docker network)
TRUSTED_PROXIES=172.16.0.0/12
SESSION_DAYS=7
VERIFY_HOURS=48
RATE_LIMITS_ENABLED=true
